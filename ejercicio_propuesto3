public class DadoFrecuencias {
    
    public static void main(String[] args) {
        int[] frecuencia = new int[6]; // posiciones 0 a 5 representan caras 1 a 6
        
        for (int i = 0; i < 20000; i++) {
            int cara = (int) (Math.random() * 6) + 1; // número entre 1 y 6
            frecuencia[cara - 1]++;
        }
        
        System.out.println("Resultados de 20000 lanzamientos:");
        for (int i = 0; i < 6; i++) {
            System.out.println("Cara " + (i + 1) + ": " + frecuencia[i] + " veces");
        }
    }
}
